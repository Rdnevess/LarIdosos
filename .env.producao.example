# Copie este arquivo para `.env.producao` e preencha os valores antes de
# rodar `docker compose up -d --build`. NUNCA versione o `.env.producao`
# preenchido — ele contém senhas.
#
# Passo a passo completo: docs/operacao/implantacao.md

# Domínio que aponta para o IP desta VPS (registro DNS tipo A já criado).
DOMINIO=lar.exemplo.org.br

# Credenciais do banco. Escolha uma senha forte — ela nunca precisa ser
# digitada por uma pessoa, só fica guardada aqui.
POSTGRES_USER=lar
POSTGRES_PASSWORD=
POSTGRES_DB=lar

# Chave usada para assinar as sessões (JWT). Gere com:
#   openssl rand -base64 32
# Trocar este valor depois de já haver usuários logados derruba todas as
# sessões ativas (força um novo login — não é destrutivo, mas é visível).
AUTH_SECRET=

# Usuário inicial (papel Coordenação), criado pelo seed no primeiro start.
# Depois do primeiro login, troque a senha na tela do sistema — o valor
# abaixo NUNCA volta a ser aplicado depois que a senha é trocada (o seed é
# idempotente: só cria o usuário se ele ainda não existir).
SEED_ADMIN_EMAIL=coordenacao@lar.exemplo.org.br
SEED_ADMIN_SENHA=
