# Proxy reverso com HTTPS automático (Let's Encrypt) para o domínio em
# ${DOMINIO}. Sem DNS público apontando para a VPS, a emissão do
# certificado falha — isso é esperado num teste local (ver
# docs/operacao/implantacao.md).
{$DOMINIO} {
	encode gzip

	# 25 MB: o mesmo teto de 20 MB por arquivo que `salvarArquivo` aplica
	# (ver next.config.ts e src/lib/arquivos.ts), com folga para o
	# envelope do multipart/form-data. Sem isto, o Caddy corta a
	# requisição antes dela chegar ao Next, e o limite configurado em
	# `serverActions.bodySizeLimit` nunca chega a ser testado.
	request_body {
		max_size 25MB
	}

	# A Content-Security-Policy NÃO fica aqui: ela vem da aplicação
	# (`next.config.ts`), onde o E2E a exercita a cada execução. **Não
	# acrescente uma segunda CSP nesta seção** — dois cabeçalhos CSP não se
	# sobrescrevem, eles se somam pela interseção mais restritiva, e a tela
	# quebra sem que nenhum dos dois arquivos pareça errado sozinho.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	reverse_proxy app:3000
}
