# Dependências
node_modules/

# Build
.next/
out/
dist/

# Ambiente — nunca versionar credenciais
.env
.env.test
.env.local
.env.*.local
.env.producao
!.env.producao.example

# Uploads (documentos, exames, comprovantes) — dados sensíveis, ficam em volume
/data/
uploads/

# Logs
*.log
npm-debug.log*

# Sistema operacional / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testes
coverage/
test-results/
playwright-report/
tests/e2e/.sessao.json
tests/e2e/.sessao-saude.json
tests/e2e/.sessao-administrativo.json

# Workspace do subagent-driven-development
.superpowers/

# Next.js
next-env.d.ts

# TypeScript
*.tsbuildinfo

# Modelos e documentos do convenio (podem conter dados sensiveis)
docs/convenio/

# Artefatos de execucao do Playwright. `test-results/` e `playwright-report/`
# so aparecem quando um teste falha — que e exatamente quando alguem commita
# com pressa. `.playwright-mcp/` acumula um snapshot por interacao do
# navegador conduzido por agente.
test-results/
playwright-report/
.playwright-mcp/

# Claude Code: as permissões do projeto são versionadas (.claude/settings.json)
# para quem clona não precisar reaprová-las uma a uma. As locais não: o arquivo
# local acumula caminhos desta máquina e permissões de sessão que não valem
# para mais ninguém.
.claude/settings.local.json
